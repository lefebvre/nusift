#pragma once
/**
 * @file
 * @brief Generated version macros and `nusift::kVersion`.
 * @ingroup core
 */
//
// Generated by CMake from cmake/version.hpp.in into the build tree; the copy you are
// reading in a build or install directory is not the file to edit.
//
// The single source of truth for NuSIFT's version is the project() call in the top-level
// CMakeLists.txt. Everything else derives from it: this header, the nusiftConfigVersion.cmake
// that answers find_package(nusift <version>), the `nusift --version` output, and the
// nusift_version root attribute stamped into every staged data store. That last one is why
// this matters more than usual here: a store carries the version of the tool that wrote it,
// so a result can always be traced back to the code that produced it.
//
// This describes the version NuSIFT was *built* from. A consumer reading it is reading the
// version it compiled against; the library is static, so there is no separate runtime query.

#define NUSIFT_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define NUSIFT_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define NUSIFT_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define NUSIFT_VERSION_STRING "@PROJECT_VERSION@"

// Single integer for ordered comparisons, e.g.
//   #if NUSIFT_VERSION_HEX >= 0x000200
// Two hex digits per component, so it stays monotonic until a component reaches 256.
#define NUSIFT_VERSION_HEX \
  ((NUSIFT_VERSION_MAJOR << 16) | (NUSIFT_VERSION_MINOR << 8) | NUSIFT_VERSION_PATCH)

namespace nusift {

// "MAJOR.MINOR.PATCH" -- the same string CMake's project() was given.
inline constexpr const char* kVersion = NUSIFT_VERSION_STRING;

}  // namespace nusift
